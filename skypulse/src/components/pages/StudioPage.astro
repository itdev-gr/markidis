---
import { pick, type Lang } from "../../i18n/strings";

interface Props { lang?: Lang; }
const { lang = "el" } = Astro.props;
const t = pick(lang);
const s = t.studio;
const eyebrow = lang === "el" ? "ΟΠΟΥΣ · 03" : "OPUS · 03";
const heading = lang === "el" ? ["Το", "στούντιο."] : ["The", "studio."];
const captions = lang === "el"
  ? ["Από το 2020", "Σε 4 αθλήματα", "Έδρα Αθήνα"]
  : ["Since 2020", "Across 4 disciplines", "HQ Athens"];
const toolsHeading = lang === "el" ? "Ο εξοπλισμός" : "The toolkit";
---
<section class="page-x" style="padding-top: calc(var(--nav-h) + 4rem); padding-bottom: 4rem;">
  <p class="eyebrow-mono mb-6">{eyebrow}</p>
  <h1 class="display-xl">
    {heading[0]} <span class="serif-italic">{heading[1]}</span>
  </h1>
  <p class="display-sm mt-10 max-w-[44ch] text-[#8E8E9F]">{s.lede}</p>
</section>

<section class="page-x" style="padding-bottom: 6rem;">
  <figure class="halftone aspect-[16/9] overflow-hidden" data-reveal>
    <img src="/media/contact.jpg" alt={s.caption} class="w-full h-full object-cover" loading="lazy" />
  </figure>
  <figcaption class="eyebrow-mono mt-4 text-[#8E8E9F]">{s.caption}</figcaption>
</section>

<section class="page-x" style="padding-bottom: 6rem;">
  <p class="eyebrow-mono mb-12">{lang === "el" ? "ΑΡΙΘΜΟΙ" : "BY THE NUMBERS"}</p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
    {s.stats.map((n, i) => (
      <div data-reveal>
        <p class="eyebrow-mono mb-4">0{i + 1}</p>
        <p class="font-display tracking-[-0.025em] leading-none whitespace-nowrap" style="font-size: clamp(56px, 7.2vw, 110px);" data-count={n}>0</p>
        <p class="mt-6 text-[#1A1A2E]">{s.statsLabels[i]}</p>
        <p class="eyebrow-mono mt-2 text-[#8E8E9F]">{captions[i]}</p>
      </div>
    ))}
  </div>
</section>

<section class="page-x" style="padding-bottom: 8rem;">
  <h2 class="display-md mb-12">{toolsHeading}</h2>
  <ul class="list-none p-0 grid grid-cols-1 md:grid-cols-2 gap-y-10 gap-x-16">
    {s.tools.map(tool => (
      <li class="border-t border-hairline pt-6" data-reveal>
        <p class="eyebrow-mono text-[#8B6BAF]">{tool.label}</p>
        <p class="mt-3 body-serif text-[#1A1A2E]">{tool.value}</p>
      </li>
    ))}
  </ul>
</section>
