---
import { pick, type Lang } from "../../i18n/strings";

interface Props { lang?: Lang; }
const { lang = "el" } = Astro.props;
const t = pick(lang);
const s = t.cta;
const c = t.common;
const alertText = s.successAlert.replace(/'/g, "\\'");
const eyebrow = lang === "el" ? "ΟΠΟΥΣ · 04" : "OPUS · 04";
const heading = lang === "el" ? ["Πες μας τη δική σου", "ιστορία."] : ["Tell us your", "story."];
---
<section class="page-x" style="padding-top: calc(var(--nav-h) + 4rem); padding-bottom: 4rem;">
  <p class="eyebrow-mono mb-6">{eyebrow}</p>
  <h1 class="display-xl">
    {heading[0]}<br/><span class="serif-italic">{heading[1]}</span>
  </h1>
  <p class="display-sm mt-10 max-w-[44ch] text-[#8E8E9F]">{s.sub}</p>
</section>

<section id="contact" class="page-x" style="padding-bottom: 8rem;">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-16">

    <form
      class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-10"
      data-reveal
      onsubmit={`event.preventDefault(); alert('${alertText}');`}
    >
      <div class="field">
        <label class="eyebrow-mono mb-2 block" for="name">{s.fields.name}</label>
        <input id="name" name="name" required autocomplete="name" />
      </div>
      <div class="field">
        <label class="eyebrow-mono mb-2 block" for="email">{s.fields.email}</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label class="eyebrow-mono mb-2 block" for="sport">{s.fields.sport}</label>
        <input id="sport" name="sport" placeholder={s.fields.sportPh} required />
      </div>
      <div class="field">
        <label class="eyebrow-mono mb-2 block" for="length">{s.fields.length}</label>
        <input id="length" name="length" placeholder={s.fields.lengthPh} required />
      </div>
      <div class="field sm:col-span-2">
        <label class="eyebrow-mono mb-2 block" for="brief">{s.fields.brief}</label>
        <textarea id="brief" name="brief" rows="5" placeholder={s.fields.briefPh}></textarea>
      </div>
      <div class="sm:col-span-2 mt-4">
        <button class="sp-btn sp-btn-primary" data-magnetic="0.35" type="submit">
          <span>{s.submit}</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12m0 0L8 2m5 5L8 12" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
      </div>
    </form>

    <aside class="lg:col-span-4 lg:col-start-9 flex flex-col gap-8 self-start" data-reveal>
      <div>
        <p class="eyebrow-mono mb-3">{s.emailLabel}</p>
        <a href={`mailto:${c.email}`} class="font-display text-2xl md:text-3xl text-[#1A1A2E] hover:text-[#8B6BAF] transition-colors">{c.email}</a>
      </div>
      <hr class="rule" />
      <div>
        <p class="eyebrow-mono mb-3">{s.phoneLabel}</p>
        <a href={c.phoneHref} class="font-display text-2xl md:text-3xl text-[#1A1A2E] hover:text-[#8B6BAF] transition-colors">{c.phone}</a>
      </div>
      <hr class="rule" />
      <div>
        <p class="eyebrow-mono mb-3">{s.hoursLabel}</p>
        <p class="font-display italic text-2xl md:text-3xl text-[#1A1A2E]">{s.hoursValue}</p>
      </div>
      <hr class="rule" />
      <div>
        <p class="eyebrow-mono mb-3">{s.responseLabel}</p>
        <p class="font-display italic text-2xl md:text-3xl text-[#8B6BAF]">{s.responseValue}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  form input, form textarea {
    width: 100%;
    background: transparent;
    color: #1A1A2E;
    border: 0;
    border-bottom: 1px solid #1A1A2E;
    padding: 0.6rem 0;
    font-family: "Newsreader", serif;
    font-size: 1.15rem;
    outline: none;
    transition: border-color .3s ease;
    resize: vertical;
  }
  form input:focus, form textarea:focus { border-bottom-color: #8B6BAF; border-bottom-width: 2px; }
</style>
