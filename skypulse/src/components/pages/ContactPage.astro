---
import { pick, type Lang } from "../../i18n/strings";
import ContactForm from "../ContactForm.astro";

interface Props { lang?: Lang; }
const { lang = "el" } = Astro.props;
const t = pick(lang);
const s = t.cta;
const c = t.common;
const eyebrow = lang === "el" ? "ΟΠΟΥΣ · 04" : "OPUS · 04";
const heading = lang === "el" ? ["Πες μας τη δική σου", "ιστορία."] : ["Tell us your", "story."];
---
<section class="page-x" style="padding-top: calc(var(--nav-h) + 4rem); padding-bottom: 4rem;">
  <p class="eyebrow-mono mb-6">{eyebrow}</p>
  <h1 class="display-xl">
    {heading[0]}<br/><span class="serif-italic">{heading[1]}</span>
  </h1>
  <p class="display-sm mt-10 max-w-[44ch] text-[#8E8E9F]">{s.sub}</p>
</section>

<section id="contact" class="page-x" style="padding-bottom: 8rem;">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-16">

    <div class="lg:col-span-7" data-reveal>
      <ContactForm lang={lang} />
    </div>

    <aside class="lg:col-span-4 lg:col-start-9 flex flex-col gap-8 self-start" data-reveal>
      <div>
        <p class="eyebrow-mono mb-3">{s.emailLabel}</p>
        <a href={`mailto:${c.email}`} class="font-display text-2xl md:text-3xl text-[#1A1A2E] hover:text-[#8B6BAF] transition-colors">{c.email}</a>
      </div>
      <hr class="rule" />
      <div>
        <p class="eyebrow-mono mb-3">{s.phoneLabel}</p>
        <a href={c.phoneHref} class="font-display text-2xl md:text-3xl text-[#1A1A2E] hover:text-[#8B6BAF] transition-colors">{c.phone}</a>
      </div>
      <hr class="rule" />
      <div>
        <p class="eyebrow-mono mb-3">{s.hoursLabel}</p>
        <p class="font-display italic text-2xl md:text-3xl text-[#1A1A2E]">{s.hoursValue}</p>
      </div>
      <hr class="rule" />
      <div>
        <p class="eyebrow-mono mb-3">{s.responseLabel}</p>
        <p class="font-display italic text-2xl md:text-3xl text-[#8B6BAF]">{s.responseValue}</p>
      </div>
    </aside>
  </div>
</section>

