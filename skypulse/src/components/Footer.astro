---
import { pick, type Lang } from "../i18n/strings";

interface Props { lang?: Lang; }
const { lang = "el" } = Astro.props;
const f = pick(lang).footer;
---
<footer class="page-x pt-16 pb-12 border-t border-hairline">
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 eyebrow-mono">
    <p>{f.copy}</p>
    <p>
      Designed &amp; developed by <a href="https://www.itdev.gr" target="_blank" rel="noopener" class="hover:text-[#8B6BAF] transition-colors">ITDEV</a>
    </p>
    <nav aria-label="Legal" class="flex gap-6">
      <a href={f.privacyHref} class="hover:text-[#8B6BAF] transition-colors">{f.privacy}</a>
    </nav>
  </div>
</footer>
