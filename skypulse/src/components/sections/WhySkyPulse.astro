---
import { pick, type Lang } from "../../i18n/strings";

interface Props { lang?: Lang; }
const { lang = "el" } = Astro.props;
const t = pick(lang);
const s = t.whySkyPulse;
---

<section class="section why sp-glow">
  <div class="container">
    <h2 class="why-lede display" data-split>{s.lede}</h2>

    <div class="why-grid">
      {s.pillars.map((p, i) => (
        <article class="why-card" data-reveal>
          <span class="mono why-num">№ 0{i + 1}</span>
          <h3 class="display">{p.name}</h3>
          <p class="body-serif">{p.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why-lede { font-size: clamp(2rem, 4vw, 3.6rem); margin: 1.5rem 0 3rem; max-width: 18ch; color: #1A1A2E; }
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid #1A1A2E;
    border-bottom: 1px solid #1A1A2E;
  }
  @media (min-width: 700px)  { .why-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .why-grid { grid-template-columns: repeat(4, 1fr); } }
  .why-card {
    padding: 2.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 280px;
    border-right: 1px solid #E0D8EC;
    transition: background .4s ease;
  }
  .why-card:last-child { border-right: 0; }
  .why-card:hover { background: #F3EEF8; }
  .why-num { color: #8E8E9F; font-size: 0.85rem; }
  .why-card h3 {
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    margin: auto 0 0;
    color: #1A1A2E;
  }
  .why-card p { color: #8E8E9F; font-size: 0.95rem; margin: 0; }
</style>
