---
import { pick, type Lang } from "../../i18n/strings";

interface Props { lang?: Lang; }
const { lang = "el" } = Astro.props;
const s = pick(lang).studio;

const eyebrow     = lang === "el" ? "04 · Το στούντιο" : "04 · The studio";
const headingPre  = lang === "el" ? "Το" : "The";
const headingEm   = lang === "el" ? "στούντιο." : "studio.";
const toolsLabel  = lang === "el" ? "Ο εξοπλισμός" : "The toolkit";
---
<section data-section="studio" class="relative z-10 min-h-screen flex flex-col justify-center page-x" style="padding-top: calc(var(--nav-h) + 2rem); padding-bottom: 4rem;" aria-label="Studio">
  <p class="eyebrow-mono mb-6">{eyebrow}</p>

  <div class="grid grid-cols-12 gap-6 items-end">
    <div class="col-span-12 md:col-span-7">
      <h2 class="display-lg leading-[0.9] tracking-[-0.02em]">
        {headingPre} <span class="serif-italic">{headingEm}</span>
      </h2>
    </div>
    <div class="col-span-12 md:col-span-5">
      <p class="body-serif text-[#8E8E9F] max-w-[44ch]">{s.lede}</p>
    </div>
  </div>

  <div class="mt-20">
    <p class="eyebrow-mono mb-10">{toolsLabel}</p>
    <ul class="list-none p-0 grid grid-cols-1 md:grid-cols-2 gap-y-10 gap-x-16">
      {s.tools.map(tool => (
        <li class="border-t border-hairline pt-6">
          <p class="eyebrow-mono text-[#8B6BAF]">{tool.label}</p>
          <p class="mt-3 body-serif text-[#1A1A2E]">{tool.value}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
