---
import { pick, type Lang } from "../../i18n/strings";

interface Props { lang?: Lang; }
const { lang = "el" } = Astro.props;
const t = pick(lang);

const videos = t.work.videos.slice(0, 4);
const eyebrow = lang === "el" ? "01 · Επιλεγμένες συνθέσεις" : "01 · Selected compositions";
const headingPre = lang === "el" ? "Γραμμένο" : "Composed";
const headingEm  = lang === "el" ? "για τον πάγο." : "for the ice.";
const lede = t.work.lede;
---
<section data-section="cameo-feature" class="relative z-10 min-h-[120vh] flex items-center page-x" aria-label="Selected compositions">
  <div class="grid grid-cols-12 gap-6 w-full items-center">

    <div class="col-span-12 md:col-span-7">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {videos.map((v, i) => (
          <button
            type="button"
            class="video-tile group relative aspect-[16/9] w-full overflow-hidden block bg-[#F3EEF8] cursor-pointer halftone"
            data-vimeo={v.id}
            aria-label={`Play: ${v.title}`}
          >
            <img src={v.thumb} alt={v.title} class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]" loading={i < 2 ? "eager" : "lazy"} />
            <span class="absolute inset-0 grid place-items-center">
              <span class="inline-flex items-center justify-center w-14 h-14 rounded-full border border-white text-white">
                <svg width="18" height="18" viewBox="0 0 22 22"><path d="M6 3v16l14-8L6 3z" fill="currentColor"/></svg>
              </span>
            </span>
          </button>
        ))}
      </div>
    </div>

    <div class="col-span-12 md:col-span-5">
      <p class="eyebrow-mono text-[#8E8E9F] mb-4" data-cameo-eyebrow>{eyebrow}</p>
      <h2 class="display-lg leading-[0.9] tracking-[-0.02em]" data-cameo-title>
        {headingPre}<br/><span class="serif-italic">{headingEm}</span>
      </h2>
      <p class="mt-6 max-w-md text-[#8E8E9F] body-serif" data-cameo-body>{lede}</p>
    </div>

  </div>
</section>
